# ACCF Ikole web app environment
# Keep real values in apps/web/.env.local or your deployment platform.
#
# Browser-safe public configuration:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave blank until trusted web-push delivery is configured.
VITE_VAPID_PUBLIC_KEY=

# Server-only API configuration. Never prefix provider/server credentials with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
